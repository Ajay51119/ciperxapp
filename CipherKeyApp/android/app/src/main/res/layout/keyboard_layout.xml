<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#101114"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#20242b"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/key_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Key: Manual"
            android:textColor="#f6f7fb"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_prev_key"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:text="Prev"
            android:textSize="10sp"
            android:textColor="#f6f7fb"
            android:backgroundTint="#303642"
            android:paddingHorizontal="0dp" />

        <Button
            android:id="@+id/btn_next_key"
            android:layout_width="42dp"
            android:layout_height="34dp"
            android:text="Next"
            android:textSize="10sp"
            android:textColor="#f6f7fb"
            android:backgroundTint="#303642"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_encode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Encode"
            android:textColor="#06110a"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#20d466" />

        <Button
            android:id="@+id/btn_decode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Decode"
            android:textColor="#f6f7fb"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#303642" />

        <Button
            android:id="@+id/btn_insert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Insert"
            android:textColor="#06110a"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#8eea44" />
    </LinearLayout>

    <EditText
        android:id="@+id/keyboard_input"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#171a20"
        android:textColor="#ffffff"
        android:textColorHint="#737986"
        android:hint="Type here, then Encode or Insert"
        android:paddingHorizontal="12dp"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textNoSuggestions"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/result_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:background="#102418"
        android:textColor="#20d466"
        android:textSize="13sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row_numbers"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/row_top"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/row_middle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/row_bottom"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_symbols"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:text="123"
            android:textSize="13sp"
            android:textColor="#f6f7fb"
            android:backgroundTint="#303642" />

        <Button
            android:id="@+id/key_comma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginStart="4dp"
            android:text=","
            android:textSize="16sp"
            android:textColor="#f6f7fb"
            android:backgroundTint="#272c35" />

        <Button
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:layout_marginStart="4dp"
            android:text="space"
            android:textSize="13sp"
            android:textColor="#d7dbe5"
            android:backgroundTint="#272c35" />

        <Button
            android:id="@+id/key_period"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginStart="4dp"
            android:text="."
            android:textSize="16sp"
            android:textColor="#f6f7fb"
            android:backgroundTint="#272c35" />

        <Button
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginStart="4dp"
            android:text="Enter"
            android:textSize="11sp"
            android:textColor="#06110a"
            android:backgroundTint="#20d466" />
    </LinearLayout>
</LinearLayout>
